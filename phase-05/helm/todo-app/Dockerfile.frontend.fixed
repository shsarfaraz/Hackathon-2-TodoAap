# Use Node 18 slim (Debian-based) as base instead of Alpine
FROM node:18-slim AS builder

# Set working directory
WORKDIR /app

# Install necessary build tools
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy package files
COPY frontend/package*.json ./

# Install dependencies with retry and lower concurrency to avoid network issues
RUN npm config set registry https://registry.npmjs.org/ && \
    npm config set cache-max 0 && \
    npm install --production --verbose || \
    npm install --production --verbose --registry https://registry.npmjs.org/

# Copy application code
COPY frontend/ .

# Build the Next.js application
RUN npm run build

# Production stage
FROM node:18-slim

# Set working directory
WORKDIR /app

# Install necessary runtime tools
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy package files
COPY frontend/package*.json ./

# Install production dependencies only with retry
RUN npm config set registry https://registry.npmjs.org/ && \
    npm install --production --verbose || \
    npm install --production --verbose --registry https://registry.npmjs.org/

# Copy built application from builder stage
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3000/ || exit 1

# Start the Next.js application
CMD ["npm", "start"]