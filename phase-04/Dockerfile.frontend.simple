# Use Node 18 slim as base
FROM node:18-bullseye AS base

# Install necessary build tools for Linux
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files
COPY frontend/package*.json ./

# Install all dependencies (not just production) to ensure build tools are available
RUN npm install

# Copy application code
COPY frontend/ .

# Pre-build to handle any platform-specific compilation
RUN npm run build || echo "Build failed but continuing..."

# Production stage
FROM node:18-bullseye

# Set working directory
WORKDIR /app

# Install necessary runtime tools
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy package files
COPY frontend/package*.json ./

# Install only production dependencies
RUN npm install --production

# Copy built application from base stage
COPY --from=base /app/.next ./.next
COPY --from=base /app/public ./public
COPY --from=base /app/node_modules ./node_modules
COPY --from=base /app/package.json ./package.json

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3000/ || exit 1

# Start the Next.js application
CMD ["npm", "start"]